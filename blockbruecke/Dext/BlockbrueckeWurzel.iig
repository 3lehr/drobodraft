#ifndef BlockbrueckeWurzel_h
#define BlockbrueckeWurzel_h

#include <DriverKit/IOService.iig>

// Wurzel auf IOUserResources (IOClass IOUserService, Muster wie Apples IOUserDockChannelSerial), erzeugt den Controller per Create().
// Grund: direkte Personality IOUserSCSIParallelInterfaceController auf IOUserResources startete nie (Messung 2026-10-17T18:54, Plan-Doku).
class BlockbrueckeWurzel : public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
};

#endif
