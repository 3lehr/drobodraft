#ifndef MaxWriteProbe_h
#define MaxWriteProbe_h

#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <SCSIPeripheralsDriverKit/IOUserSCSIPeripheralDeviceType00.iig>

// Stufe 3b Messpunkt: Dext sendet Lese-CDBs (INQUIRY, MODE SENSE(10)) per UserSendCDB OHNE UserSuspendServices.
// Ausloeser: Host oeffnet UserClient, Selektor 0, Skalar 1 = INQUIRY, 2 = MODE SENSE(10) Seite 0x3F; Antwort als Struktur (Text).
// (Property-Weg ProbeCmd scheitert: Kernel speichert sie, ruft SetProperties im Dext nicht auf.)
class MaxWriteProbe : public IOUserSCSIPeripheralDeviceType00
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t UserDetermineDeviceCharacteristics(bool *result) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient **userClient) override;
};


#endif
