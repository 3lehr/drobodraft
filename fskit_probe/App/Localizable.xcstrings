            "state": "translated",
            "value": "Default when mounting"
          }
        }
      }
    },
    "Vorher wird eine Sicherung der Verwaltungsdaten des Laufwerks angelegt. Ohne gelungene Sicherung wird nicht zum Schreiben eingehängt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorher wird eine Sicherung der Verwaltungsdaten des Laufwerks angelegt. Ohne gelungene Sicherung wird nicht zum Schreiben eingehängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup of the drive's management data is made first. Without a successful backup nothing is mounted writable."
          }
        }
      }
    },
