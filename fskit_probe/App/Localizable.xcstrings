    "Drobo ausgehängt, aber die Prüfung hat Auffälligkeiten gefunden. Details im Protokoll.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drobo ausgehängt, aber die Prüfung hat Auffälligkeiten gefunden. Details im Protokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drobo unmounted, but the check found issues. Details in the log."
          }
        }
      }
    },
