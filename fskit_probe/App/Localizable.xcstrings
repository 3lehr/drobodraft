          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The status data is no longer current. It is not read while the DroboPro is mounted; “Find Drobos” reads it again."
          }
        }
      }
    },
    "Die Suche im lokalen Netzwerk ist nicht möglich. Läuft der Hilfsdienst?": {
      "localizations": {
