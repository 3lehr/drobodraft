    "Hängt die Drobo nur lesend oder zum Schreiben ein. Zum Schreiben wird vorher die Verwaltungsdaten-Sicherung angelegt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt die Drobo nur lesend oder zum Schreiben ein. Zum Schreiben wird vorher die Verwaltungsdaten-Sicherung angelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mounts the Drobo read-only or writable. Before writing, a backup of the management data is made."
          }
        }
      }
    },
