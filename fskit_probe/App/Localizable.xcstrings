    "Vor dem nächsten Einhängen wird das Laufwerk geprüft. Beim nächsten Mal bitte zuerst aushängen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem nächsten Einhängen wird das Laufwerk geprüft. Beim nächsten Mal bitte zuerst aushängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive will be checked before the next mount. Next time please unmount first."
          }
        }
      }
    },
    "Vor dem nächsten Einhängen wird geprüft: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem nächsten Einhängen wird geprüft: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the next mount a check runs: %@"
          }
        }
      }
    },
    "Vor jedem Einhängen zum Schreiben wird automatisch gesichert. Aufbewahrt werden %lld Sicherungen in %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jedem Einhängen zum Schreiben wird automatisch gesichert. Aufbewahrt werden %lld Sicherungen in %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup is made automatically before every writable mount. %lld backups are kept in %@."
          }
        }
      }
    },
    "Vorgabe beim Einhängen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgabe beim Einhängen"
          }
