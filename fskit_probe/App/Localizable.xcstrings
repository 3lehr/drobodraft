    "Immer erst aushängen, dann abziehen. Wird ein Laufwerk im Schreibzustand getrennt, prüft die App es vor dem nächsten Einhängen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer erst aushängen, dann abziehen. Wird ein Laufwerk im Schreibzustand getrennt, prüft die App es vor dem nächsten Einhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always unmount first, then unplug. If a drive is disconnected while writable, the app checks it before the next mount."
          }
        }
      }
    },
