            "state": "translated",
            "value": "Standard: aus. Die App startet dann beim Anmelden im Hintergrund mit Symbol in der Menüleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: off. The app then starts at login in the background with an icon in the menu bar."
          }
        }
      }
    },
