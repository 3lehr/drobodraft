    "1. Systemeinstellungen öffnen, Siri & Spotlight, Spotlight-Datenschutz.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Systemeinstellungen öffnen, Siri & Spotlight, Spotlight-Datenschutz."
          }
        }
      }
    },
    "2. Mit dem Plus-Knopf den Einhängeort der Drobo hinzufügen (Standard: /private/tmp/drobo_mnt, im Finder über Gehe zu Ordner).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Mit dem Plus-Knopf den Einhängeort der Drobo hinzufügen (Standard: /private/tmp/drobo_mnt, im Finder über Gehe zu Ordner)."
          }
        }
      }
    },
    "3. Für Time Machine: Systemeinstellungen, Allgemein, Time Machine, Optionen, die Drobo zur Liste der ausgeschlossenen Objekte hinzufügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Für Time Machine: Systemeinstellungen, Allgemein, Time Machine, Optionen, die Drobo zur Liste der ausgeschlossenen Objekte hinzufügen."
          }
        }
      }
    },
